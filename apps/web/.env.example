# Supabase auth (public — safe in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase service role — server-only, NEVER exposed to the browser.
# Required for the password-reset OTP flow (admin.generateLink).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Resend — server-only, used to send password-reset OTP emails.
RESEND_API_KEY=re_...
EMAIL_FROM="Cuadra <no-reply@your-verified-domain.com>"

# Public app URL (used for absolute URLs in OG tags, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL of the @crm/api service. In Railway: http://api.railway.internal:8080
API_URL=http://localhost:8080
